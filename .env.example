# 数据库容器账号（docker compose 会读取；部署到服务器时务必把 POSTGRES_PASSWORD 改成强密码）
POSTGRES_USER=banyu
POSTGRES_PASSWORD=banyu
POSTGRES_DB=banyu

# 本地开发直连数据库的连接串；容器内会自动改用上面的账号拼出指向 db 主机的地址
DATABASE_URL="postgresql://banyu:banyu@localhost:5432/banyu"

# 后端监听端口；banyu-web 的 .env.local 里 API_BASE 要指向 http://localhost:<PORT>
PORT=8787

# 允许跨域直连的前端地址（逗号分隔）。走 Next rewrite 代理时同源，可留空
CORS_ORIGIN=http://localhost:3000
